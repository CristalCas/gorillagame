.auth-box { max-width: 420px; width: 100%; margin: auto; background: rgba(0,0,0,0.6); border: 2px solid #ff8a00; border-radius: 25px; padding: 30px 25px; box-shadow: 0 0 50px rgba(255,138,0,0.4); }
