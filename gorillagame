/* ================== ХРАНИЛИЩЕ ================== */
const USERS_KEY = 'gorilla_users';
const CURRENT_KEY = 'gorilla_current';
const EVENTS_KEY = 'gorilla_events';
const PROMOS_KEY = 'gorilla_promos';
const LUCK_KEY = 'gorilla_luck';

function getAllUsers() {
    try { return JSON.parse(localStorage.getItem(USERS_KEY)) || {}; }
    catch(e) { return {}; }
}
function saveAllUsers(u) { localStorage.setItem(USERS_KEY, JSON.stringify(u)); }

function getEvents() {
    try { return JSON.parse(localStorage.getItem(EVENTS_KEY)) || []; }
    catch(e) { return []; }
}
function saveEvents(list) { localStorage.setItem(EVENTS_KEY, JSON.stringify(list.slice(-30))); }
function addEvent(text) {
    const events = getEvents();
    events.push({ text: text, time: Date.now() });
    saveEvents(events);
    renderEvents();
}
function renderEvents() {
    const events = getEvents();
    const track = document.getElementById('event-track');
    if (!track) return;
    let list = events.slice().reverse();
    if (!list.length) list = [{ text: '🦍 Добро пожаловать в GorillaGame!' }];
    track.innerHTML = list.map(e => `<span>${escapeHtml(e.text)}</span>`).join('');
}

function getPromos() {
    try { return JSON.parse(localStorage.getItem(PROMOS_KEY)) || {}; }
    catch(e) { return {}; }
}
function savePromos(p) { localStorage.setItem(PROMOS_KEY, JSON.stringify(p)); }

function getLuck() {
    try { return JSON.parse(localStorage.getItem(LUCK_KEY)) || {}; }
    catch(e) { return {}; }
}
function saveLuck(l) { localStorage.setItem(LUCK_KEY, JSON.stringify(l)); }

function hashPassword(pwd) {
    let h = 5381;
    const salt = 'gorilla_salt_v1';
    const str = salt + pwd + salt;
    for (let i = 0; i < str.length; i++) {
        h = ((h << 5) + h) + str.charCodeAt(i);
        h = h | 0;
    }
    return 'h_' + Math.abs(h).toString(36) + '_' + str.length;
}

function validateUsername(u) {
    if (!u) return 'Введи @username';
    if (u.length < 5) return 'Минимум 5 символов';
    if (u.length > 20) return 'Максимум 20 символов';
    if (!/^[a-zA-Z0-9_]+$/.test(u)) return 'Только латиница, цифры и _';
    if (!/[a-zA-Z]/.test(u)) return 'Должна быть хотя бы одна буква';
    return null;
}

function findUserByUsername(username) {
    const lower = username.toLowerCase();
    const users = getAllUsers();
    for (const id in users) {
        if ((users[id].username || '').toLowerCase() === lower) return users[id];
    }
    return null;
}

/* ================== АВТОРИЗАЦИЯ ================== */
function switchTab(tab) {
    document.getElementById('tab-login').classList.toggle('active', tab === 'login');
    document.getElementById('tab-register').classList.toggle('active', tab === 'register');
    document.getElementById('form-login').classList.toggle('hidden', tab !== 'login');
    document.getElementById('form-register').classList.toggle('hidden', tab !== 'register');
    document.getElementById('login-error').classList.remove('show');
    document.getElementById('reg-error').classList.remove('show');
}

let selectedRole = 'user';
function selectRole(role) {
    selectedRole = role;
    document.querySelectorAll('.role-option').forEach(el => {
        el.classList.toggle('active', el.dataset.role === role);
    });
    document.getElementById('reg-admin-code-field').classList.toggle('hidden', role !== 'admin');
    if (role !== 'admin') document.getElementById('reg-admin-code').value = '';
}

document.addEventListener('DOMContentLoaded', () => {
    const loginUser = document.getElementById('login-username');
    const regUser = document.getElementById('reg-username');
    if (loginUser) {
        loginUser.addEventListener('input', () => {
            const v = loginUser.value.trim();
            const hint = document.getElementById('login-username-hint');
            if (!v) { hint.textContent = 'Только латиница, минимум 5 символов'; hint.className = 'auth-hint'; return; }
            const err = validateUsername(v);
            if (err) { hint.textContent = '❌ ' + err; hint.className = 'auth-hint error'; loginUser.classList.add('invalid'); loginUser.classList.remove('valid'); }
            else {
                const existing = findUserByUsername(v);
                if (!existing) { hint.textContent = '❌ Пользователь не найден'; hint.className = 'auth-hint error'; loginUser.classList.add('invalid'); loginUser.classList.remove('valid'); }
                else { hint.textContent = '✅ Найден: ' + existing.name; hint.className = 'auth-hint ok'; loginUser.classList.add('valid'); loginUser.classList.remove('invalid'); }
            }
        });
    }
    if (regUser) {
        regUser.addEventListener('input', () => {
            const v = regUser.value.trim();
            const hint = document.getElementById('reg-username-hint');
            if (!v) { hint.textContent = 'Только латиница (a-z), цифры, _, минимум 5 символов'; hint.className = 'auth-hint'; regUser.classList.remove('invalid', 'valid'); return; }
            const err = validateUsername(v);
            if (err) { hint.textContent = '❌ ' + err; hint.className = 'auth-hint error'; regUser.classList.add('invalid'); regUser.classList.remove('valid'); }
            else {
                const existing = findUserByUsername(v);
                if (existing) { hint.textContent = '❌ @' + v + ' уже занят'; hint.className = 'auth-hint error'; regUser.classList.add('invalid'); regUser.classList.remove('valid'); }
                else { hint.textContent = '✅ @' + v + ' свободен'; hint.className = 'auth-hint ok'; regUser.classList.add('valid'); regUser.classList.remove('invalid'); }
            }
        });
    }
    document.getElementById('login-password')?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') doLogin();
    });
});

function doRegister() {
    const username = document.getElementById('reg-username').value.trim();
    const name = document.getElementById('reg-name').value.trim();
    const pwd = document.getElementById('reg-password').value;
    const pwd2 = document.getElementById('reg-password2').value;
    const adminCode = document.getElementById('reg-admin-code').value.trim();
    const err = document.getElementById('reg-error');
    err.classList.remove('show');
    const uErr = validateUsername(username);
    if (uErr) { err.textContent = '❌ Username: ' + uErr; err.classList.add('show'); return; }
    if (findUserByUsername(username)) { err.textContent = '❌ @' + username + ' уже занят'; err.classList.add('show'); return; }
    if (!name || name.length < 2) { err.textContent = '❌ Введи имя (мин. 2 символа)'; err.classList.add('show'); return; }
    if (pwd.length < 6) { err.textContent = '❌ Пароль минимум 6 символов'; err.classList.add('show'); return; }
    if (pwd !== pwd2) { err.textContent = '❌ Пароли не совпадают'; err.classList.add('show'); return; }
    if (selectedRole === 'admin' && adminCode !== ADMIN_CODE) { err.textContent = '❌ Неверный код админа'; err.classList.add('show'); return; }
    const id = 'u_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7);
    const users = getAllUsers();
    users[id] = {
        id: id, username: username, name: name,
        passwordHash: hashPassword(pwd), role: selectedRole,
        balance: START_BALANCE, nft_inventory: [], last_free_case: null,
        cases_opened: 0, blocked: false, created: Date.now(), photo_url: ''
    };
    saveAllUsers(users);
    localStorage.setItem(CURRENT_KEY, id);
    user = users[id];
    addEvent(`🆕 ${name} зарегистрировался в игре!`);
    document.getElementById('auth-overlay').classList.add('hidden');
    document.getElementById('app').classList.remove('hidden');
    initApp();
}

function doLogin() {
    const username = document.getElementById('login-username').value.trim();
    const pwd = document.getElementById('login-password').value;
    const err = document.getElementById('login-error');
    err.classList.remove('show');
    const uErr = validateUsername(username);
    if (uErr) { err.textContent = '❌ ' + uErr; err.classList.add('show'); return; }
    if (!pwd) { err.textContent = '❌ Введи пароль'; err.classList.add('show'); return; }
    const found = findUserByUsername(username);
    if (!found) { err.textContent = '❌ Пользователь @' + username + ' не найден'; err.classList.add('show'); return; }
    if (found.passwordHash !== hashPassword(pwd)) { err.textContent = '❌ Неверный пароль'; err.classList.add('show'); return; }
    if (found.blocked) { err.textContent = '🚫 Аккаунт заблокирован админом'; err.classList.add('show'); return; }
    localStorage.setItem(CURRENT_KEY, found.id);
    user = found;
    document.getElementById('auth-overlay').classList.add('hidden');
    document.getElementById('app').classList.remove('hidden');
    initApp();
}

function logout() {
    if (!confirm('Выйти из аккаунта?')) return;
    localStorage.removeItem(CURRENT_KEY);
    location.reload();
}

let currentUserId = localStorage.getItem(CURRENT_KEY);
let user = null;

function saveUser() {
    if (!user) return;
    const users = getAllUsers();
    users[user.id] = user;
    saveAllUsers(users);
    document.getElementById('balance').textContent = user.balance;
    updateProfileUI();
