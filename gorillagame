    white-space: pre-line; position: relative; z-index: 1001;
}
@keyframes pop { 0% { transform: scale(0.5); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
.modal-content h2 { margin-bottom: 15px; font-size: 26px; }
.modal-content p { margin-bottom: 25px; font-size: 18px; }
