.auth-box .auth-sub { text-align: center; opacity: 0.65; margin-bottom: 20px; font-size: 13px; }
.auth-tabs { display: flex; gap: 8px; margin-bottom: 20px; background: rgba(0,0,0,0.4); padding: 6px; border-radius: 14px; }
.auth-tab { flex: 1; padding: 12px; border-radius: 10px; background: transparent; border: none; color: #fff; font-size: 15px; font-weight: bold; cursor: pointer; transition: all 0.3s; }
.auth-tab.active { background: linear-gradient(135deg, #ff8a00, #e52e71); box-shadow: 0 4px 15px rgba(255,138,0,0.4); }
.auth-field { margin-bottom: 12px; }
.auth-field label { display: block; font-size: 12px; opacity: 0.7; margin-bottom: 5px; padding-left: 4px; }
.auth-field input { width: 100%; padding: 14px 16px; background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.2); border-radius: 12px; color: #fff; font-size: 15px; transition: all 0.3s; }
.auth-field input:focus { outline: none; border-color: #ff8a00; box-shadow: 0 0 0 3px rgba(255,138,0,0.15); }
.auth-field input.invalid { border-color: #ff2e63; }
.auth-field input.valid { border-color: #00b36b; }
.auth-hint { font-size: 11px; opacity: 0.55; margin-top: 4px; padding-left: 4px; line-height: 1.4; }
.auth-hint.error { color: #ff6b8a; opacity: 1; }
.auth-hint.ok { color: #4ddb99; opacity: 1; }
.auth-error { background: rgba(255,46,99,0.2); color: #ff8a9e; padding: 12px; border-radius: 10px; margin-top: 12px; font-size: 13px; text-align: center; display: none; line-height: 1.5; }
.auth-error.show { display: block; }
.auth-btn { width: 100%; padding: 15px; background: linear-gradient(135deg, #ff8a00, #e52e71); border: none; border-radius: 15px; color: #fff; font-size: 17px; font-weight: bold; cursor: pointer; transition: all 0.3s; margin-top: 15px; }
.auth-btn:hover { transform: scale(1.02); box-shadow: 0 0 25px rgba(255,138,0,0.6); }
.role-select { display: flex; gap: 10px; margin-bottom: 15px; }
.role-option { flex: 1; padding: 15px 10px; border-radius: 12px; background: rgba(255,255,255,0.05); border: 2px solid rgba(255,255,255,0.15); cursor: pointer; transition: all 0.3s; text-align: center; }
.role-option:hover { background: rgba(255,255,255,0.1); }
.role-option.active { border-color: #ff8a00; background: rgba(255,138,0,0.15); box-shadow: 0 0 20px rgba(255,138,0,0.4); }
.role-option .role-icon { font-size: 30px; margin-bottom: 5px; }
.role-option .role-name { font-size: 13px; font-weight: bold; }
@media (max-width: 600px) {
