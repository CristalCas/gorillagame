.upg-result-box img { width: 40px; height: 40px; object-fit: contain; }
.upgrade-btn {
    display: block; width: 100%; padding: 18px;
    background: linear-gradient(135deg, #ff8a00, #e52e71);
    border: none; border-radius: 15px; color: #fff;
    font-size: 20px; font-weight: bold; cursor: pointer;
    transition: all 0.3s; margin-top: 10px;
}
.upgrade-btn:hover:not(:disabled) { transform: scale(1.02); box-shadow: 0 0 30px rgba(255,138,0,0.6); }
.upgrade-btn:disabled { opacity: 0.4; cursor: not-allowed; }
.pvp-players { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; margin-bottom: 20px; }
