}

/* ================== РЕНДЕР КЕЙСОВ ================== */
function renderCases() {
    const grid = document.getElementById('cases-grid');
    if (!grid) return;
    grid.innerHTML = Object.keys(CASES).map(key => {
        const c = CASES[key];
        return `<div class="case-card ${c.cls}" onclick="openCase('${key}')">
            <div class="case-img">${c.img}</div>
            <h3>${c.name}</h3>
            <p>${c.price} ⭐</p>
            <small>Топ NFT</small>
        </div>`;
    }).join('');
}

/* ================== ОТКРЫТИЕ КЕЙСА ================== */
function rollReward(rewards, caseKey) {
    const luck = getLuck();
    const luckBonus = luck[caseKey] || 0;
    const total = rewards.reduce((s, r) => s + r.chance, 0);
    const r = Math.random() * total;
    let upto = 0;
    for (const rw of rewards) {
        let chance = rw.chance;
        if (rw.nft && luckBonus) chance = chance * (1 + luckBonus / 100);
        upto += chance;
        if (r <= upto) return rw;
    }
    return rewards[rewards.length - 1];
}

function openCase(caseKey) {
    const c = CASES[caseKey];
    if (!c) return;
    if (user.balance < c.price) {
        showModal('❌ Недостаточно средств', `Нужно ${c.price} ⭐\nУ тебя: ${user.balance} ⭐`);
        return;
    }
    user.balance -= c.price;
    user.cases_opened = (user.cases_opened || 0) + 1;
    const reward = rollReward(c.rewards, caseKey);
    if (reward.nft) {
        user.nft_inventory.push(reward.name);
        showModal('🎉 ТЫ ВЫБИЛ NFT!', reward.name, reward.name);
        addEvent(`🎁 ${user.name} выбил ${reward.name}`);
    } else {
        user.balance += reward.value;
        showModal('🎁 Выпало:', reward.name);
    }
    saveUser();
    renderInventory();
}

function openFreeCase() {
    const now = Date.now();
    const DAY = 24 * 60 * 60 * 1000;
    if (user.last_free_case && now - user.last_free_case < DAY) {
        const remaining = DAY - (now - user.last_free_case);
        const h = Math.floor(remaining / 3600000);
        const m = Math.floor((remaining % 3600000) / 60000);
        showModal('⏳ Подожди', `Следующий бесплатный кейс\nчерез ${h}ч ${m}мин`);
        return;
    }
    user.last_free_case = now;
    user.cases_opened = (user.cases_opened || 0) + 1;
    const reward = rollReward(FREE_REWARDS, 'free');
    if (reward.nft) {
        user.nft_inventory.push(reward.name);
        showModal('🎉 ТЫ ВЫБИЛ NFT!', reward.name, reward.name);
        addEvent(`🎁 ${user.name} выбил ${reward.name} в бесплатном кейсе`);
    } else {
        user.balance += reward.value;
        showModal('🎁 Бесплатный кейс:', reward.name);
    }
    saveUser();
    renderInventory();
}

/* ================== CRASH ================== */
let crashState = { playing: false, multiplier: 1.00, crashAt: 0, interval: null, bet: 100 };

function selectBet(amount) {
    if (crashState.playing) return;
    crashState.bet = amount;
    document.querySelectorAll('.bet-option').forEach(el => {
        el.classList.toggle('active', parseInt(el.textContent) === amount);
    });
    document.getElementById('bet-display').textContent = amount;
}

function startCrash() {
    if (crashState.playing) return;
    if (user.balance < crashState.bet) {
        showModal('❌ Недостаточно средств', `Нужно ${crashState.bet} ⭐`); return;
    }
    user.balance -= crashState.bet;
    saveUser();
    crashState.playing = true;
    crashState.multiplier = 1.00;
    crashState.crashAt = 1 + Math.random() * 9;
    document.getElementById('start-btn').disabled = true;
    document.getElementById('stop-btn').disabled = false;
    document.getElementById('crash-status').textContent = 'Успей нажать СТОП!';
    document.getElementById('multiplier').textContent = '1.00x';
    crashState.interval = setInterval(() => {
        crashState.multiplier += 0.1 + Math.random() * 0.3;
        document.getElementById('multiplier').textContent = crashState.multiplier.toFixed(2) + 'x';
        if (crashState.multiplier >= crashState.crashAt) crash();
    }, 400);
}

function stopCrash() {
    if (!crashState.playing) return;
    clearInterval(crashState.interval);
    crashState.playing = false;
    const win = Math.floor(crashState.bet * crashState.multiplier);
    user.balance += win;
    saveUser();
    document.getElementById('start-btn').disabled = false;
    document.getElementById('stop-btn').disabled = true;
    document.getElementById('crash-status').textContent = `✅ Выигрыш: +${win} ⭐`;
    showModal('✅ Ты остановился!', `Множитель: ${crashState.multiplier.toFixed(2)}x\nВыигрыш: +${win} ⭐`);
    addEvent(`🎮 ${user.name} выиграл ${win} ⭐ в краше (x${crashState.multiplier.toFixed(2)})`);
}

function crash() {
    clearInterval(crashState.interval);
    crashState.playing = false;
    document.getElementById('start-btn').disabled = false;
    document.getElementById('stop-btn').disabled = true;
    document.getElementById('multiplier').textContent = crashState.crashAt.toFixed(2) + 'x 💥';
    document.getElementById('crash-status').textContent = 'КРАШ! Попробуй ещё раз';
    showModal('💥 КРАШ!', `Ты потерял ${crashState.bet} ⭐\nКраш на ${crashState.crashAt.toFixed(2)}x`);
    addEvent(`💥 ${user.name} потерял ${crashState.bet} ⭐ в краше`);
}

