.case-card h3 { margin-bottom: 5px; font-size: 15px; }
.case-card p { font-weight: bold; color: #ff8a00; margin-bottom: 5px; }
.case-card small { opacity: 0.75; font-size: 12px; }
.case-card h3, .case-card small { color: #fff; }
.case-card p { color: #ff8a00 !important; }
.bronze { border-color: #cd7f32; } .bronze:hover { box-shadow: 0 0 30px #cd7f32; }
.silver { border-color: #c0c0c0; } .silver:hover { box-shadow: 0 0 30px #c0c0c0; }
.gold { border-color: #ffd700; } .gold:hover { box-shadow: 0 0 30px #ffd700; }
.diamond { border-color: #00d4ff; } .diamond:hover { box-shadow: 0 0 30px #00d4ff; }
