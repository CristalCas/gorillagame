.upg-row { display: grid; grid-template-columns: 1fr 50px 1fr; gap: 12px; align-items: stretch; margin-bottom: 20px; }
.upg-col { background: rgba(0,0,0,0.35); border: 1px solid rgba(255,255,255,0.1); border-radius: 15px; padding: 15px; }
