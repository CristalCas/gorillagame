.role-admin { background: linear-gradient(135deg, #ffd700, #ff8a00); color: #000; }
.role-user { background: rgba(255,255,255,0.15); color: #fff; }
.stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; width: 100%; max-width: 400px; }
.stat-box { padding: 15px 10px; background: rgba(0,0,0,0.4); border-radius: 12px; text-align: center; }
.stat-box .value { font-size: 20px; font-weight: bold; color: #ff8a00; }
.stat-box .label { font-size: 11px; opacity: 0.7; margin-top: 4px; }
.upgrader-info {
