.pvp-result.win { background: rgba(0,255,136,0.15); color: #00ff88; border: 2px solid #00ff88; }
.pvp-result.lose { background: rgba(255,46,99,0.15); color: #ff2e63; border: 2px solid #ff2e63; }
.promo-box { display: flex; gap: 8px; margin-bottom: 20px; }
